generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  googleId        String           @unique
  email           String           @unique
  name            String
  avatarUrl       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  campaigns       EmailCampaign[]
  senders         Sender[]
  slackConnection SlackConnection?

  @@index([email])
}

model Sender {
  id           String          @id @default(uuid())
  userId       String
  email        String
  displayName  String
  smtpHost     String
  smtpPort     Int
  smtpUser     String
  smtpPassword String
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  emails       Email[]
  campaigns    EmailCampaign[]
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
}

model EmailCampaign {
  id                 String   @id @default(uuid())
  userId             String
  senderId           String
  subject            String
  body               String
  startTime          DateTime
  delayBetweenEmails Int      @default(2000)
  hourlyLimit        Int      @default(200)
  status             String   @default("ACTIVE")
  totalRecipients    Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  emails             Email[]
  sender             Sender   @relation(fields: [senderId], references: [id])
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([senderId])
}

model Email {
  id                       String        @id @default(uuid())
  campaignId               String
  senderId                 String
  recipient                String
  subject                  String
  body                     String
  scheduledAt              DateTime
  sentAt                   DateTime?
  status                   String        @default("SCHEDULED")
  failureReason            String?
  bullJobId                String?       @unique
  idempotencyKey           String        @unique
  attempts                 Int           @default(0)
  etherealMessageUrl       String?
  processingStartedAt      DateTime?
  processingLeaseExpiresAt DateTime?
  processingWorkerId       String?
  sendAttemptedAt          DateTime?
  clientMessageId          String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  campaign                 EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender                   Sender        @relation(fields: [senderId], references: [id])

  @@index([campaignId, status])
  @@index([senderId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([idempotencyKey])
  @@index([status, processingLeaseExpiresAt])
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  accessToken String
  teamId      String
  teamName    String
  channelId   String?
  connected   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
